(require 'package)

;; ============================================================
;; PACKAGE MANAGEMENT
;; ============================================================

(setq frame-resize-pixelwise t)

(setq package-archives
      '(("gnu" . "https://elpa.gnu.org/packages/")
        ("melpa" . "https://melpa.org/packages/")))

(package-initialize)

(setq use-package-always-ensure t)

(require 'use-package)

;; ============================================================
;; GENERAL SETTINGS
;; ============================================================

(setq inhibit-startup-screen t)

(when (display-graphic-p)
  (push '(background-color . "#FFFFEE") default-frame-alist))

;; Hide unnecessary UI elements
(push '(tool-bar-lines . 0) default-frame-alist)

(menu-bar-mode 0)
(scroll-bar-mode 0)

;; ============================================================
;; BOOKMARKS
;; ============================================================

(setq bookmark-bmenu-toggle-filenames t)
(setq bookmark-sort-flag 'last-modified)

;; Do NOT automatically open *Bookmark List* at startup.
;; Use M-x list-bookmarks when you want it.

;; ============================================================
;; BACKUPS
;; ============================================================

(setq make-backup-files t)

;; Make backup names incremental:
;; file~1~, file~2~, etc.

(setq version-control t)
(setq delete-old-versions t)

;; Preserve hard links, creation date, owner, etc.
(setq backup-by-copying t)

;; Store backups in ~/.emacs.d/save/
(setq backup-directory-alist
      `(("." . ,(expand-file-name "~/.emacs.d/save/"))))

;; Disable automatic save files.
(setq auto-save-default nil)

;; Disable lock files.
(setq create-lockfiles nil)

;; ============================================================
;; CURSOR / DISPLAY
;; ============================================================

(setq-default cursor-type '(bar . 3))

(blink-cursor-mode 0)

(setq use-dialog-box nil)

(setq mouse-highlight nil)

(setq max-mini-window-height 0.7)

;; ============================================================
;; TEXT DISPLAY
;; ============================================================

(global-visual-line-mode 1)

;; Pretty symbols globally.
(global-prettify-symbols-mode 1)

;; ============================================================
;; FONT
;; ============================================================

;; Uncomment/change this if JetBrains Mono is installed.
;; (set-face-attribute 'default nil
;;                     :font "JetBrains Mono"
;;                     :height 140)

;; ============================================================
;; COMPLETION
;; ============================================================

(setq completion-max-candidates 8)

;; ============================================================
;; KEYBINDS
;; ============================================================

(global-set-key [f5] #'save-buffer)

(global-set-key [f8] #'find-file)

(global-set-key (kbd "C-<tab>") #'other-window)

(global-set-key (kbd "C-:") #'ibuffer)

;; ============================================================
;; KILL BUFFER + FULLSCREEN
;; ============================================================

(defun kill-buffer-and-fullscreen ()
  "Kill current buffer and make the remaining buffer fullscreen."
  (interactive)
  (kill-current-buffer)
  (delete-other-windows))

(global-set-key (kbd "C-;") #'kill-buffer-and-fullscreen)

;; ============================================================
;; AUTO REVERT
;; ============================================================

(global-auto-revert-mode 1)

(setq global-auto-revert-non-file-buffers t)

;; ============================================================
;; BELL
;; ============================================================

(setq visible-bell t)

;; ============================================================
;; DOOM MODELINE
;; ============================================================

;; Uncomment these if you want Doom Modeline.
(require 'doom-modeline)

(setq doom-modeline-support-imenu t)
(setq doom-modeline-total-line-number t)

(doom-modeline-mode 1)

;; ============================================================
;; ESHELL TOGGLE
;; ============================================================

(defun my/toggle-eat ()
  "Toggle Eshell at the bottom of the frame."
  (interactive)
  (let ((eshell-buffer (get-buffer "*eshell*")))
    (if (and eshell-buffer
             (get-buffer-window eshell-buffer 'visible))
        (delete-windows-on eshell-buffer)
      (let ((display-buffer-alist
             '(("\\*eshell\\*"
                (display-buffer-reuse-window
                 display-buffer-pop-up-window)
                (window-height . 0.33)
                (reusable-frames . visible)
                (dedicated . t)))))
        (if eshell-buffer
            (display-buffer eshell-buffer)
          (eshell))))))

(global-set-key (kbd "C-!") #'my/toggle-eat)

;; ============================================================
;; LOAD PERSONAL CONFIGURATION
;; ============================================================

;; These files are optional. They are only loaded if they exist.

(when (file-exists-p "~/.emacs.d/programmingmode.el")
  (load "~/.emacs.d/programmingmode.el"))

(when (file-exists-p "~/.emacs.d/package.el")
  (load "~/.emacs.d/package.el"))

(when (file-exists-p "~/.emacs.d/note_and_writting_mode.el")
  (load "~/.emacs.d/note_and_writting_mode.el"))

;; ============================================================
;; IBUFFER / DIRED ICONS
;; ============================================================

(with-eval-after-load 'nerd-icons-ibuffer
  (add-hook 'ibuffer-mode-hook #'nerd-icons-ibuffer-mode))

(with-eval-after-load 'nerd-icons-dired
  (add-hook 'dired-mode-hook #'nerd-icons-dired-mode))

;; Folder icon
(with-eval-after-load 'nerd-icons
  (add-to-list
   'nerd-icons-dir-icon-alist
   '("." nerd-icons-faicon "nf-fa-folder"
     :face nerd-icons-lyellow)))

;; ============================================================
;; DIRECTORY ALIAS
;; ============================================================

(defalias 'rmdir #'delete-directory)

;; ============================================================
;; VERTICO
;; ============================================================

(with-eval-after-load 'vertico
