(defun my/toggle-eshell ()
  "Toggle Eshell at the bottom of the frame with a sensible height (~1/3 of frame).
Never opens full-screen, never triggers window-resize errors."
  (interactive)
  (let ((eshell-buffer (get-buffer "*eshell*")))
    (if (and eshell-buffer
             (get-buffer-window eshell-buffer 'visible))
        ;; Eshell is visible → hide it
        (delete-windows-on eshell-buffer)
      ;; Eshell is hidden or does not exist → show it at the bottom
      (let ((display-buffer-alist
             '(("\\*eshell\\*"
                (display-buffer-reuse-window display-buffer-pop-up-window)
                (reusable-frames . visible)
                (window-height . 0.33)          ;; ≈1/3 of frame height
                (dedicated . t)
                (pop-up-window . t)))))
        (if eshell-buffer
            (display-buffer eshell-buffer)
          (eshell))))))

(global-set-key (kbd "C-!") 'my/toggle-eshell)
(global-set-key (kbd "C-<tab>") 'other-window)
